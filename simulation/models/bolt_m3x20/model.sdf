<?xml version="1.0"?>
<sdf version="1.9">
  <!-- ISO 4017 육각 머리 볼트 M3×20(scripts/generate_hex_bolt_models.py 생성, 매끈한 축·모따기 생략). 원점 = 머리·축 경계, +Z 머리 쪽.
       맞변 s 5.5 mm, 머리 높이 k 2.0 mm, 맞모서리 e 6.35 mm, 축 d 3.0 mm × l 20.0 mm, 전체 22 mm.
       충돌: 머리 = 상자 3개(0·60·120°) 합집합 = 정육각 기둥, 축 = 원기둥. 질량·관성: 강철 7850 kg/m³ 메시 적분 -->
  <model name="bolt_m3x20">
    <link name="link">
      <inertial>
        <pose>0 0 -0.00701939 0 0 0</pose>
        <mass>0.0015179</mass>
        <inertia><ixx>7.4790e-08</ixx><iyy>7.4790e-08</iyy><izz>2.9694e-09</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="head0"><pose>0 0 0.001 0 0 0.000000</pose>
        <geometry><box><size>0.0055 0.00317543 0.002</size></box></geometry></collision>
      <collision name="head1"><pose>0 0 0.001 0 0 1.047198</pose>
        <geometry><box><size>0.0055 0.00317543 0.002</size></box></geometry></collision>
      <collision name="head2"><pose>0 0 0.001 0 0 2.094395</pose>
        <geometry><box><size>0.0055 0.00317543 0.002</size></box></geometry></collision>
      <collision name="shank"><pose>0 0 -0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.0015</radius><length>0.02</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><mesh><uri>model://bolt_m3x20/meshes/bolt_m3x20.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.468 0.480 0.504 1</ambient>
          <diffuse>0.78 0.8 0.84 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr><metal><metalness>0.35</metalness><roughness>0.35</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
