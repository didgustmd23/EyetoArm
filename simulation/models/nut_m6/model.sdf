    <link name="link">
      <inertial>
        <pose>0 0 0.0026 0 0 0</pose>
        <mass>0.002381</mass>
        <inertia><ixx>2.337e-08</ixx><iyy>2.337e-08</iyy><izz>3.601e-08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
