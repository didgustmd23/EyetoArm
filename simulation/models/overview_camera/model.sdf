<?xml version="1.0"?>
<sdf version="1.9">
  <model name="overview_cam">
    <static>true</static>
    <link name="camera_link">
      <!-- 광학 중심은 링크 원점, 하우징은 시야 뒤쪽에 배치한다. -->
      <visual name="housing">
        <pose>-0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.10 0.16 0.10</size></box></geometry>
        <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
      <visual name="lens">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.08 0.25 0.45 1</ambient><diffuse>0.08 0.25 0.45 1</diffuse></material>
      </visual>
      <sensor name="overview_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>overview_cam/image</topic>
        <gz_frame_id>overview_cam_optical_frame</gz_frame_id>
        <camera>
          <!-- 사용자 확정 화각. 이전 25% 가로 축소 중간값보다 시야를 더 좁힌 설정. -->
          <horizontal_fov>1.0034063702</horizontal_fov>
          <image><width>960</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </link>
    <frame name="overview_cam_optical_frame" attached_to="camera_link">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
    </frame>
  </model>
</sdf>
