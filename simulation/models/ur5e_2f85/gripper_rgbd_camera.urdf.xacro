<?xml version="1.0"?>
<!-- 그리퍼 앞면 매립형 범용 RGB-D 시뮬레이션 센서. 특정 실물 모델의 보정값이 아니다. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="gripper_rgbd_camera" params="parent xyz rpy">
    <link name="gripper_cam_link">
      <!-- 외부 하우징 없이 얇은 렌즈면만 표시. 기본 배치에서 그리퍼 앞면 Z≈0.09m. -->
      <visual>
        <origin xyz="0.0215 -0.012 0" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.006" length="0.002"/></geometry>
        <material name="gripper_rgb_lens"><color rgba="0.08 0.25 0.45 1"/></material>
      </visual>
      <visual>
        <origin xyz="0.0215 0.012 0" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.006" length="0.002"/></geometry>
        <material name="gripper_depth_lens"><color rgba="0.25 0.08 0.08 1"/></material>
      </visual>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.0000281667" ixy="0" ixz="0" iyy="0.0000101667" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <joint name="gripper_cam_joint" type="fixed">
      <parent link="${parent}"/><child link="gripper_cam_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="gripper_cam_optical_frame"/>
    <joint name="gripper_cam_optical_joint" type="fixed">
      <parent link="gripper_cam_link"/><child link="gripper_cam_optical_frame"/>
      <origin xyz="0.0225 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>
    <gazebo reference="gripper_cam_link">
      <sensor name="gripper_rgbd" type="rgbd_camera">
        <pose>0.0225 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>gripper_cam</topic>
        <gz_frame_id>gripper_cam_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
