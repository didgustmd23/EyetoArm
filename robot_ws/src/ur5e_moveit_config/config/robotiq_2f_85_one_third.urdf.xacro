<?xml version="1.0"?>
<!--
  Robotiq 2F-85, 모든 길이를 원본의 1/3 으로 고정 축소한 시뮬레이션 전용 모델(조절 옵션 없음, 사용자 요청 2026-11-20. 같은 날 2/3 → 1/3 로 재요청).

  출처: ros-jazzy-robotiq-description 0.0.1 (Ubuntu 24.04 패키지 0.0.1-3noble.20260920.234159)
        urdf/robotiq_2f_85_macro.urdf.xacro 의 robotiq_gripper 매크로에서 링크·관절을 옮겨 왔다.
        작성자 Cory Crean, 유지자 PickNik Robotics, 라이선스 BSD(설치된 package.xml·/usr/share/doc/ros-jazzy-robotiq-description/copyright).
        원본 저장소 PickNikRobotics/ros2_robotiq_gripper 의 LICENSE(BSD 3-Clause) 전문을 이 머리말 끝에 그대로 둔다.
        이 파일은 그 원본의 수정 파생물이다(simulation/THIRD_PARTY_NOTICES.md 의 robotiq_description 행 참고).
        메시는 설치된 robotiq_description 의 것을 그대로 참조하고 복사하지 않는다.
  바꾼 것(그 밖의 이름·축·각도 한계·effort·velocity·mimic·접촉 파라미터는 원본 그대로):
    - visual·collision 메시: scale = 1/3 (원점 기준 등방 축소)
    - 관절 origin xyz, 링크 inertial origin xyz: × 1/3
    - inertia 텐서: × (1/3)^2. 질량은 바꾸지 않는다(실물 1/3 그리퍼의 질량을 가정하지 않기 위해,
      같은 질량이 1/3 크기에 분포한 것으로 둔다).
    - ros2_control 블록은 넣지 않는다. 호출하는 ur5e_2f85.urdf.xacro 가 팔과 함께 묶는다(원본 include_ros2_control=false 와 같음).
  각도로만 정의된 값(관절 한계 0~0.8 rad, mimic 배율)은 등방 축소에서 그대로이므로 손가락 연결 기구학은 원본과 닮은꼴이다.
  축소 영향 경계(이 파일 밖, 값은 원본 기준으로 남아 있음): 손끝까지 길이·최대 벌림(원본 85 mm → 약 28.3 mm),
  tool0 → 집게 중심(G) 오프셋, 그리퍼 카메라 외부 보정. 모델 README 대신 이 주석과 작업 보고에 둔다.

  원본 LICENSE 전문 (https://github.com/PickNikRobotics/ros2_robotiq_gripper/blob/main/LICENSE):

  BSD 3-Clause License

  Copyright (c) 2022, PickNik Robotics
  All rights reserved.

  Redistribution and use in source and binary forms, with or without
  modification, are permitted provided that the following conditions are met:

  1. Redistributions of source code must retain the above copyright notice, this
     list of conditions and the following disclaimer.

  2. Redistributions in binary form must reproduce the above copyright notice,
     this list of conditions and the following disclaimer in the documentation
     and/or other materials provided with the distribution.

  3. Neither the name of the copyright holder nor the names of its
     contributors may be used to endorse or promote products derived from
     this software without specific prior written permission.

  THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
  AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
  IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE
  DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE
  FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
  DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR
  SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER
  CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
  OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
  OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="robotiq_2f_85_one_third" params="prefix parent *origin">
    <xacro:property name="s" value="${1.0 / 3.0}"/>
    <xacro:property name="s2" value="${s * s}"/>
    <xacro:property name="mesh" value="file://$(find robotiq_description)/meshes"/>

    <xacro:macro name="scaled_mesh" params="name">
      <visual>
        <geometry><mesh filename="${mesh}/visual/${name}.dae" scale="${s} ${s} ${s}"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh}/collision/${name}.stl" scale="${s} ${s} ${s}"/></geometry>
      </collision>
    </xacro:macro>

    <!-- 원본 손끝 접촉 파라미터(값 그대로). Gazebo Sim 에서는 ODE 블록이 무시될 수 있다 -->
    <xacro:macro name="tip_collision" params="name">
      <visual>
        <geometry><mesh filename="${mesh}/visual/${name}.dae" scale="${s} ${s} ${s}"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh}/collision/${name}.stl" scale="${s} ${s} ${s}"/></geometry>
        <surface>
          <friction><ode><mu1>100000.0</mu1><mu2>100000.0</mu2></ode></friction>
          <contact><ode><kp>1e+5</kp><kd>1</kd><soft_cfm>0</soft_cfm><soft_erp>0.2</soft_erp><minDepth>0.002</minDepth><maxVel>0</maxVel></ode></contact>
        </surface>
      </collision>
    </xacro:macro>

    <!-- inertial: 원본 위치 × s, 원본 질량, 원본 관성 × s^2 -->
    <xacro:macro name="scaled_inertial" params="x y z m ixx iyy izz ixy ixz iyz">
      <inertial>
        <origin xyz="${s * x} ${s * y} ${s * z}" rpy="0 0 0"/>
        <mass value="${m}"/>
        <inertia ixx="${s2 * ixx}" iyy="${s2 * iyy}" izz="${s2 * izz}" ixy="${s2 * ixy}" ixz="${s2 * ixz}" iyz="${s2 * iyz}"/>
      </inertial>
    </xacro:macro>

    <link name="${prefix}robotiq_85_base_link">
      <xacro:scaled_mesh name="robotiq_base"/>
      <xacro:scaled_inertial x="0.0" y="2.274e-05" z="0.03232288" m="6.6320197e-01"
        ixx="5.1617816e-04" iyy="5.8802208e-04" izz="3.9462776e-04" ixy="2.936e-8" ixz="0.0" iyz="-3.2296e-7"/>
    </link>
    <link name="${prefix}robotiq_85_left_knuckle_link">
      <xacro:scaled_mesh name="left_knuckle"/>
      <xacro:scaled_inertial x="0.01213197" y="0.0002" z="-0.00058647" m="1.384773208e-02"
        ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="1.1744e-7" iyz="0"/>
    </link>
    <link name="${prefix}robotiq_85_right_knuckle_link">
      <xacro:scaled_mesh name="right_knuckle"/>
      <xacro:scaled_inertial x="-0.01213197" y="0.0002" z="-0.00058647" m="1.384773208e-02"
        ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="-1.1744e-7" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_left_finger_link">
      <xacro:scaled_mesh name="left_finger"/>
      <xacro:scaled_inertial x="0.00346899" y="-0.00079447" z="0.01867121" m="4.260376752e-02"
        ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="-2.17264e-06" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_right_finger_link">
      <xacro:scaled_mesh name="right_finger"/>
      <xacro:scaled_inertial x="-0.00346899" y="-5.53e-06" z="0.01867121" m="4.260376752e-02"
        ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="2.17264e-06" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_left_inner_knuckle_link">
      <xacro:scaled_mesh name="left_inner_knuckle"/>
      <xacro:scaled_inertial x="0.01897699" y="0.00015001" z="0.02247101" m="2.969376448e-02"
        ixx="9.57136e-06" iyy="8.69056e-06" izz="8.19144e-06" ixy="0.0" ixz="-3.93424e-06" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_right_inner_knuckle_link">
      <xacro:scaled_mesh name="right_inner_knuckle"/>
      <xacro:scaled_inertial x="-0.01926824" y="5.001e-05" z="0.02222178" m="2.969376448e-02"
        ixx="9.42456e-06" iyy="8.69056e-06" izz="8.33824e-06" ixy="0.0" ixz="3.9636e-06" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_left_finger_tip_link">
      <xacro:tip_collision name="left_finger_tip"/>
      <xacro:scaled_inertial x="-0.01456706" y="-0.0008" z="0.01649701" m="4.268588744e-02"
        ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="3.5232e-6" iyz="0.0"/>
    </link>
    <link name="${prefix}robotiq_85_right_finger_tip_link">
      <xacro:tip_collision name="right_finger_tip"/>
      <xacro:scaled_inertial x="0.01456706" y="5e-05" z="0.01649701" m="4.268588744e-02"
        ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="-3.5232e-06" iyz="0.0"/>
    </link>

    <joint name="${prefix}robotiq_85_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}robotiq_85_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_knuckle_joint" type="revolute">
      <parent link="${prefix}robotiq_85_base_link"/>
      <child link="${prefix}robotiq_85_left_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * 0.03060114} 0.0 ${s * 0.05490452}" rpy="0 0 0"/>
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_knuckle_joint" type="revolute">
      <parent link="${prefix}robotiq_85_base_link"/>
      <child link="${prefix}robotiq_85_right_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * -0.03060114} 0.0 ${s * 0.05490452}" rpy="0 0 0"/>
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50"/>
      <mimic joint="${prefix}robotiq_85_left_knuckle_joint" multiplier="-1"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_finger_joint" type="fixed">
      <parent link="${prefix}robotiq_85_left_knuckle_link"/>
      <child link="${prefix}robotiq_85_left_finger_link"/>
      <origin xyz="${s * 0.03152616} 0.0 ${s * -0.00376347}" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_finger_joint" type="fixed">
      <parent link="${prefix}robotiq_85_right_knuckle_link"/>
      <child link="${prefix}robotiq_85_right_finger_link"/>
      <origin xyz="${s * -0.03152616} 0.0 ${s * -0.00376347}" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}robotiq_85_base_link"/>
      <child link="${prefix}robotiq_85_left_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * 0.0127} 0.0 ${s * 0.06142}" rpy="0 0 0"/>
      <mimic joint="${prefix}robotiq_85_left_knuckle_joint"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}robotiq_85_base_link"/>
      <child link="${prefix}robotiq_85_right_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * -0.0127} 0.0 ${s * 0.06142}" rpy="0 0 0"/>
      <mimic joint="${prefix}robotiq_85_left_knuckle_joint" multiplier="-1"/>
    </joint>
    <joint name="${prefix}robotiq_85_left_finger_tip_joint" type="continuous">
      <parent link="${prefix}robotiq_85_left_finger_link"/>
      <child link="${prefix}robotiq_85_left_finger_tip_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * 0.00563134} 0.0 ${s * 0.04718515}" rpy="0 0 0"/>
      <mimic joint="${prefix}robotiq_85_left_knuckle_joint" multiplier="-1"/>
    </joint>
    <joint name="${prefix}robotiq_85_right_finger_tip_joint" type="continuous">
      <parent link="${prefix}robotiq_85_right_finger_link"/>
      <child link="${prefix}robotiq_85_right_finger_tip_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="${s * -0.00563134} 0.0 ${s * 0.04718515}" rpy="0 0 0"/>
      <mimic joint="${prefix}robotiq_85_left_knuckle_joint"/>
    </joint>
  </xacro:macro>
</robot>
