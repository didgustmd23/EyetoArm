# 대용량 촬영 원본·녹화·rosbag은 아래 로컬 폴더에 보관
# 공유할 예제 영상·평가 자료·보정 파일·마커·로봇 모델은 별도 경로에서 관리
/data/raw/*
!/data/raw/README.md
!/data/raw/.gitkeep
/recordings/*
!/recordings/README.md
!/recordings/.gitkeep
/rosbags/*
!/rosbags/README.md
!/rosbags/.gitkeep

# 로컬 접속 정보·환경 변수 (공유 예제는 포함)
