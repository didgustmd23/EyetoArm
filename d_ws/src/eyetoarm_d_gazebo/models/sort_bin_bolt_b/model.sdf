<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 윗면이 열린 상자 160 x 120 x 80 mm, 벽 4 mm(임시값). 원점=바닥 중심 -->
  <model name="sort_bin_bolt_b">
    <static>true</static>
    <link name="link">
      <collision name="floor"><pose>0 0 0.002 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.004</size></box></geometry></collision>
      <collision name="wall_py"><pose>0 0.057999999999999996 0.04 0 0 0</pose>
        <geometry><box><size>0.16 0.004 0.08</size></box></geometry></collision>
      <collision name="wall_ny"><pose>0 -0.057999999999999996 0.04 0 0 0</pose>
        <geometry><box><size>0.16 0.004 0.08</size></box></geometry></collision>
      <collision name="wall_px"><pose>0.078 0 0.04 0 0 0</pose>
        <geometry><box><size>0.004 0.12 0.08</size></box></geometry></collision>
      <collision name="wall_nx"><pose>-0.078 0 0.04 0 0 0</pose>
        <geometry><box><size>0.004 0.12 0.08</size></box></geometry></collision>
      <visual name="visual">
        <geometry><mesh><uri>model://sort_bin/meshes/bin.stl</uri></mesh></geometry>
        <material>
          <ambient>0.126 0.378 0.228 1</ambient>
          <diffuse>0.21 0.63 0.38 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.55</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
